# ThreatNex Environment Configuration Template
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="ThreatNex"

# Backend Security
SECRET_KEY=threatnex-super-secret-development-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
# Local SQLite for zero-config testing: sqlite+aiosqlite:///./threatnex.db
# PostgreSQL for production/docker: postgresql+asyncpg://threatnex:threatnex_secure_password@localhost:5432/threatnex_db
DATABASE_URL=sqlite+aiosqlite:///./threatnex.db

# PostgreSQL Service (Docker Compose)
POSTGRES_USER=threatnex
POSTGRES_PASSWORD=threatnex_secure_password
POSTGRES_DB=threatnex_db

# Redis Caching & Queue
REDIS_URL=redis://localhost:6379/0

# Future Phase External Threat Intelligence API Keys (Do not populate in Phase 1)
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# ALIENVAULT_OTX_KEY=
# URLSCAN_API_KEY=
