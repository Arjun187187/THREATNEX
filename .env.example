# ==============================================================================
# THREATNEX Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific settings.
# Never commit the actual '.env' file or production credentials to version control.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="THREATNEX"

# Backend Cryptographic Security
# REQUIRED: Must be at least 32 characters in production
SECRET_KEY=threatnex-super-secret-development-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
# Local SQLite for isolated testing: sqlite+aiosqlite:///./threatnex.db
# PostgreSQL for production/docker: postgresql+asyncpg://threatnex:threatnex_secure_password@localhost:5432/threatnex_db
DATABASE_URL=postgresql+asyncpg://threatnex:threatnex_secure_password@localhost:5432/threatnex_db

# PostgreSQL Container Service Configuration
POSTGRES_USER=threatnex
POSTGRES_PASSWORD=threatnex_secure_password
POSTGRES_DB=threatnex_db

# Redis Caching, Distributed Rate Limiting & Revocation Queue
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# External Threat Intelligence Provider API Keys (Optional / Free Tier)
# ==============================================================================
# Populate these with your keys to enable multi-engine IOC enrichment and feeds.
# If omitted, providers gracefully fall back to unrestricted public endpoints.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
ALIENVAULT_OTX_API_KEY=your_alienvault_otx_api_key_here
URLHAUS_AUTH_KEY=your_urlhaus_auth_key_here

# Google Gemini AI Threat Analyst Integration Key
GEMINI_API_KEY=your_gemini_api_key_here
